# Copy to .env (git-ignored) and fill in. Placeholder values only; never commit a real key.
ANTHROPIC_API_KEY=sk-ant-replace-me

# ClinicalTrials.gov client: live | record | replay
TRIALMATCH_HTTP=live
TRIALMATCH_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
TRIALMATCH_EFFORT=high
TRIALMATCH_MAX_TURNS=25
TRIALMATCH_MAX_CONCURRENT_RUNS=2
# Cap on queued plus running API jobs; further POST /matches get 429
TRIALMATCH_MAX_QUEUED_RUNS=10
# Bearer token required by the API (all endpoints except /healthz). Leave empty only
# for a localhost-only setup. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRIALMATCH_API_TOKEN=replace-with-a-long-random-token
# Directory of FHIR Bundle JSON files (defaults to the repo's data/patients)
# TRIALMATCH_PATIENT_DIR=data/patients
